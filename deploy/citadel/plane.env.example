# Template for /srv/plane/plane.env on citadel. Copy, fill secrets, chmod 600.
# Real file is gitignored (holds secrets).
APP_DOMAIN=pm.int.soltysik.net
WEB_URL=https://pm.int.soltysik.net
CORS_ALLOWED_ORIGINS=https://pm.int.soltysik.net
API_BASE_URL=http://api:8000
DEBUG=0
GUNICORN_WORKERS=1
SECRET_KEY=__GENERATE__            # tr -dc a-z0-9 </dev/urandom | head -c50

SITE_ADDRESS=:80                   # Caddy plain HTTP; citadel nginx terminates TLS
TRUSTED_PROXIES=0.0.0.0/0
CERT_EMAIL=
CERT_ACME_DNS=
FILE_SIZE_LIMIT=10485760

PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgresql://plane:__POSTGRES_PASSWORD__@plane-db/plane

REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=__GENERATE__
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:__RABBITMQ_PASSWORD__@plane-mq:5672/plane

USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=__GENERATE__
AWS_SECRET_ACCESS_KEY=__GENERATE__
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
MINIO_ENDPOINT_SSL=0

LIVE_SERVER_SECRET_KEY=__GENERATE__
API_KEY_RATE_LIMIT=60/minute

# OIDC (Keycloak realm soltysik-int). Secret from: kcadm get clients/<id>/client-secret
IS_OIDC_ENABLED=1
OIDC_CLIENT_ID=plane
OIDC_CLIENT_SECRET=__FROM_KEYCLOAK__
OIDC_ISSUER_URL=https://auth.int.soltysik.net/realms/soltysik-int
